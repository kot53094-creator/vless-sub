# VPN Hub — скопируйте в .env и заполните. В репозиторий .env не попадает.

# ─── Основное ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8080
TZ=Europe/Moscow
DATA_DIR=/data

# ─── Секреты ─────────────────────────────────────────────────────────────────
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Хеш пароля: docker compose run --rm app python -m app.cli hash-password 'пароль'
ADMIN_PASSWORD_HASH=
ADMIN_USER=admin
# Необязательно: второй фактор
TOTP_SECRET=
# Секрет ссылки подписки: /sub/<токен>
SUB_TOKEN=

# ─── Модуль A ────────────────────────────────────────────────────────────────
# Один User-Agent для всех источников (как у Happ)
FETCH_UA=Happ/2.9.1
FETCH_INTERVAL_HOURS=6
CHECK_TIMEOUT=5
CHECK_WORKERS=12
# Режим «белые списки»: проба раз в N секунд
DETECTOR_ENABLED=true
DETECTOR_INTERVAL=300
PROBE_RU_URL=https://ya.ru/
PROBE_FOREIGN_URL=https://www.gstatic.com/generate_204

# ─── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=
ADMIN_TG_ID=8938447065
# Канал для обязательной подписки (модуль B), например @my_channel
CHANNEL_ID=
TELEGRAM_PROXY=

# ─── Модуль B (необязательно) ────────────────────────────────────────────────
# Без REMNAWAVE_URL раздел «Люди» скрыт, всё остальное работает.
REMNAWAVE_URL=
REMNAWAVE_TOKEN=
# Пробный период
TRIAL_DAYS=3
TRIAL_GB=5
TRIAL_DEVICES=2
TRIAL_SQUAD=
