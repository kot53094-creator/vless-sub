# ─── VPN Hub ────────────────────────────────────────────────────────────────
# Скопируйте в .env и заполните. Файл в .gitignore, в репозиторий не попадает.

HUB_APP_NAME=VPN Hub
HUB_PUBLIC_URL=https://hub.example.com

# Секрет для подписи сессий: python -c "import secrets;print(secrets.token_urlsafe(48))"
HUB_SECRET_KEY=

# Токен публичной подписки: по нему Happ забирает список
# python -c "import secrets;print(secrets.token_urlsafe(24))"
HUB_SUB_TOKEN=

# Вход в панель. Либо пароль в открытом виде (хешируется при старте),
# либо готовый argon2-хеш: python -c "from argon2 import PasswordHasher;print(PasswordHasher().hash('пароль'))"
HUB_ADMIN_USER=admin
HUB_ADMIN_PASSWORD=
HUB_ADMIN_PASSWORD_HASH=
HUB_SESSION_HOURS=72

# ─── Синхронизация ──────────────────────────────────────────────────────────
# Встроенный планировщик: пересборка раз в N часов.
# Поставьте 0, если синхронизацию запускает systemd-таймер или cron (deploy/),
# иначе прогоны будут дублироваться.
HUB_SCHEDULER_ENABLED=1
HUB_SYNC_INTERVAL_HOURS=6
HUB_FETCH_TIMEOUT=20
HUB_CHECK_TIMEOUT=6
HUB_CHECK_ATTEMPTS=3
HUB_CHECK_WORKERS=16
# Панели вроде Titan отдают конфиги только своему клиенту — этот UA решает
HUB_USER_AGENT=Happ/2.9.1

# ─── Детектор белых списков (этап 4) ────────────────────────────────────────
HUB_DETECTOR_ENABLED=0
HUB_DETECTOR_INTERVAL=300
HUB_PROBE_RU_URL=https://ya.ru/
HUB_PROBE_FOREIGN_URL=https://www.google.com/generate_204

# ─── Remnawave (этап 2) ─────────────────────────────────────────────────────
REMNAWAVE_URL=
REMNAWAVE_TOKEN=
# Если в вашей версии панели другие пути — переопределите точечно:
# REMNAWAVE_PATHS_JSON={"users": "/api/users", "devices": "/api/hwid/devices/{uuid}"}

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Данные ─────────────────────────────────────────────────────────────────
HUB_DATA_DIR=/data
# HUB_DATABASE_URL=sqlite:////data/hub.sqlite3
