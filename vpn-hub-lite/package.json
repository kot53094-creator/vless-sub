{
  "name": "vpn-hub-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Персональный VPN-хаб на Cloudflare Workers: D1, KV, Telegram-бот, персональные подписки Happ",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:apelsinka": "wrangler deploy -c wrangler.apelsinka.toml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply vpn-hub-lite --local",
    "db:migrate": "wrangler d1 migrations apply vpn-hub-lite --remote",
    "db:export": "wrangler d1 export vpn-hub-lite --remote --output backups/vpn-hub-export.sql",
    "db:export:schema": "wrangler d1 export vpn-hub-lite --remote --no-data --output backups/schema.sql",
    "db:restore": "node tools/restore-backup.mjs",
    "db:to-turso": "node tools/export-to-turso.mjs",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.90.0"
  }
}
