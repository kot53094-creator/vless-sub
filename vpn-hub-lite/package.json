{
  "name": "vpn-hub-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Персональный VPN-хаб на Cloudflare Workers: D1, KV, Telegram-бот, персональные подписки Happ",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply vpn-hub-lite --local",
    "db:migrate": "wrangler d1 migrations apply vpn-hub-lite --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.90.0"
  }
}
