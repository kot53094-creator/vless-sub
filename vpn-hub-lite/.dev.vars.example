# Локальные секреты для `wrangler dev`.
# Скопируйте в .dev.vars (файл в .gitignore) и заполните.
# На проде те же значения ставятся через `wrangler secret put <ИМЯ>`.

# Токен бота из @BotFather
BOT_TOKEN=

# Второй фактор для вебхука: придумайте строку и передайте её в setWebhook (secret_token)
WEBHOOK_SECRET=

# Токен входа на /admin — длинная случайная строка
ADMIN_TOKEN=

# Соль для хэшей IP и User-Agent (не менять после запуска, иначе история устройств обнулится)
SALT=

# Переопределение админа (необязательно, по умолчанию из wrangler.toml)
# ADMIN_TG_ID=8938447065
