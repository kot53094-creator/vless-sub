# Локальные секреты для `wrangler dev`.
# Скопируйте в .dev.vars (файл в .gitignore) и заполните.
# На проде те же значения ставятся через `wrangler secret put <ИМЯ>`.

# Токен бота из @BotFather
BOT_TOKEN=

# Второй фактор для вебхука: придумайте строку и передайте её в setWebhook (secret_token)
WEBHOOK_SECRET=

# Токен входа на /admin — длинная случайная строка
ADMIN_TOKEN=

# Соль для хэшей IP и User-Agent (не менять после запуска, иначе история устройств обнулится)
SALT=

# Переопределение админа (необязательно, по умолчанию из wrangler.toml)
# ADMIN_TG_ID=8938447065

# Тихие часы: ночью не проверяем узлы и не тянем источники (квоты не тратятся).
# Формат «начало-конец» по местному времени; off — выключить.
QUIET_HOURS="23-8"
QUIET_UTC_OFFSET="8"

# ── Платный контур ────────────────────────────────────────────────────────
# Способы оплаты: stars,cryptopay,yookassa. Пусто — включатся сами те, для
# которых заполнены секреты ниже (Stars работает всегда, если есть BOT_TOKEN).
PAY_PROVIDERS=

# Crypto Pay (@CryptoBot → Crypto Pay → Create App). Оплата в USDT/TON.
CRYPTOPAY_TOKEN=

# ЮKassa: shopId и секретный ключ магазина. Оплата картой на /pay/<id>.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
# Почта для чека 54-ФЗ. Без неё чек не отправляется (см. docs/PAID-LAUNCH.md).
YOOKASSA_RECEIPT_EMAIL=

# Сколько рублей стоит одна звезда Telegram — для пересчёта цены тарифа.
# Меняется вслед за курсом; 1.3 — стартовое значение.
STAR_RUB=1.3

# Сколько часов живёт неоплаченный счёт (по умолчанию 24).
ORDER_TTL_HOURS=24

# Пробный доступ новым пользователям.
TRIAL_ENABLED=1
TRIAL_DAYS=3
TRIAL_DEVICES=2

# Реквизиты для оферты, страницы возврата и контактов. Без них документы
# показывают предупреждение «реквизиты не заполнены».
LEGAL_ENTITY=
LEGAL_INN=
LEGAL_EMAIL=
LEGAL_TG=

# Устройства и трафик
# Лимит устройств по умолчанию, если в тарифе не задан.
DEVICE_LIMIT=2
# Токен агента узлов для POST /api/traffic (можно тот же, что CHECK_TOKEN).
TRAFFIC_TOKEN=
# Перевод без эквайринга (СБП по номеру / карта). Пусто — кнопка не показывается.
PAY_PHONE=
PAY_CARD=
PAY_RECEIVER=
